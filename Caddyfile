{
	default_sni {$REIFY_HOST_IP}
	https_port 12888
	http_port 80
	auto_https disable_redirects
}

http://{$REIFY_HOST_IP} {
	@notacme not path /.well-known/acme-challenge/*
	redir @notacme https://{$REIFY_HOST_IP}:12888{uri} 308
	respond 404
}

# Platform UI/API: SSR app paths are intentionally not served on this origin.
https://{$REIFY_HOST_IP}:12888 {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	handle /apps/* {
		respond 404
	}
	handle {
		reverse_proxy reify:12888 {
			flush_interval -1
		}
	}
}

# SSR apps live on a separate origin (IP + port) so generated JS cannot read
# platform API responses. Only /apps/* is reachable here.
https://{$REIFY_HOST_IP}:{$REIFY_SSR_PORT:12889} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	handle /apps/* {
		reverse_proxy reify:12888 {
			flush_interval -1
		}
	}
	handle {
		respond 404
	}
}
