# Server
REIFY_HOST=0.0.0.0
REIFY_PORT=12888
REIFY_DATA=./data
REIFY_PROJECTS=./projects
REIFY_DB=./data/reify.db
REIFY_STEP_DELAY=0.55
REIFY_MAX_CONCURRENT=4

# Optional OpenAI-compatible model endpoint.
# Without a base URL the deterministic local director is used.
REIFY_LLM_ENABLED=0
REIFY_LLM_BASE_URL=
REIFY_LLM_API_KEY=
REIFY_LLM_MODEL=
REIFY_LLM_TIMEOUT=45
REIFY_LLM_MAX_TOKENS=1200
REIFY_LLM_REFINE_MAX_TOKENS=3000

# Media studios
# Defaults to the LLM endpoint root derived from REIFY_LLM_BASE_URL.
# Set REIFY_MEDIA_API_BASE for DashScope-compatible media APIs.
REIFY_MEDIA_API_BASE=
REIFY_MEDIA_API_KEY=
REIFY_IMAGE_MODEL=qwen-image-3.0-pro
REIFY_VIDEO_MODEL=wan3.0-video
REIFY_IMAGE_COUNT=4
REIFY_VIDEO_DURATION=5
REIFY_VIDEO_RESOLUTION=720P
REIFY_MEDIA_TIMEOUT=900
REIFY_VIDEO_POLL_INTERVAL=10

# Access, accounts and sessions
# The first admin is created at startup; other users can self-register.
REIFY_ADMIN_USER=admin
REIFY_ADMIN_PASSWORD=change-me
# open | closed
REIFY_REGISTRATION=open
REIFY_REGISTRATION_MAX_PER_HOUR=5
REIFY_AUTH_TTL=604800
# Set to 1 when serving over HTTPS; 0 only for local HTTP development.
REIFY_COOKIE_SECURE=0
# React build sandbox (OpenSandbox server, Docker runtime)
# off | opensandbox
REIFY_SANDBOX=off
REIFY_SANDBOX_DOMAIN=127.0.0.1:8080
REIFY_SANDBOX_API_KEY=
REIFY_SANDBOX_PROTOCOL=http
REIFY_SANDBOX_SERVER_PROXY=1
REIFY_SANDBOX_IMAGE=node:24-bookworm-slim
REIFY_SANDBOX_CPU=1
REIFY_SANDBOX_MEMORY=1Gi
# Next.js build needs more heap; the current 55 host uses 4Gi.
REIFY_SANDBOX_BUILD_MEMORY=2Gi
REIFY_SANDBOX_TTL=900
REIFY_SANDBOX_READY_TIMEOUT=120
REIFY_SANDBOX_REQUEST_TIMEOUT=600
REIFY_SANDBOX_CONCURRENCY=2
# allowlist | open
# The 55 host cannot start the egress sidecar; deploy uses open there.
REIFY_SANDBOX_EGRESS=allowlist
REIFY_SANDBOX_EGRESS_ALLOW=*.npmmirror.com,registry.npmjs.org,*.npmjs.org
REIFY_NPM_REGISTRY=https://registry.npmmirror.com
REIFY_NPM_INSTALL_TIMEOUT=600
REIFY_NPM_BUILD_TIMEOUT=600
REIFY_NEXT_ARTIFACT_MAX_BYTES=125829120

# Next.js SSR runtime
REIFY_RUNTIME_TTL=3600
REIFY_RUNTIME_IDLE=600
REIFY_RUNTIME_READY_TIMEOUT=90
REIFY_RUNTIME_PORT=3000
# 0 = runtime is started/stopped but /apps preview is disabled (recommended until a domain exists)
REIFY_SSR_PREVIEW=0
REIFY_SSR_PORT=12889

# Per-project static runtime (static sites, games, built React dist).
# off = serve /p/ and /s/ from local files; opensandbox = one runtime per published
# project. When enabled there is no local-file fallback: an unavailable runtime
# returns 503 instead of serving the artifact directly.
REIFY_STATIC_RUNTIME=off
REIFY_STATIC_RUNTIME_IMAGE=nginx:alpine
REIFY_STATIC_RUNTIME_MEMORY=256Mi
REIFY_MAX_STATIC_RUNTIME_PER_USER=5

# Host path allowlisted by the OpenSandbox server for per-project /data volumes.
REIFY_SANDBOX_HOST_DATA_ROOT=
REIFY_MAX_STORAGE_PER_USER=1073741824

# Copy legacy flat projects into the first admin's account at startup.
REIFY_AUTO_MIGRATE=1
# Optional database path (defaults to data/reify.db).
# REIFY_DB=/data/reify.db

# Long-tail generation (pages + games)
REIFY_LLM_LONGTAIL_MAX_TOKENS=24000
REIFY_LLM_LONGTAIL_TIMEOUT=240
# Set to 0 if the provider rejects enable_thinking
REIFY_LLM_LONGTAIL_DISABLE_THINKING=1

# Per-user quotas
REIFY_MAX_PROJECTS_PER_USER=50
REIFY_MAX_ACTIVE_PER_USER=2
REIFY_MAX_ACTIVE_REACT_PER_USER=1
REIFY_MAX_RUNTIME_PER_USER=2
REIFY_MAX_STORAGE_PER_USER=1073741824
