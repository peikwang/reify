# Server
VIBEFORGE_HOST=0.0.0.0
VIBEFORGE_PORT=12888
VIBEFORGE_STEP_DELAY=0.55
VIBEFORGE_MAX_CONCURRENT=4

# Optional OpenAI-compatible model endpoint.
# Without a base URL the deterministic local director is used.
VIBEFORGE_LLM_ENABLED=0
VIBEFORGE_LLM_BASE_URL=
VIBEFORGE_LLM_API_KEY=
VIBEFORGE_LLM_MODEL=
VIBEFORGE_LLM_TIMEOUT=45
VIBEFORGE_LLM_MAX_TOKENS=1200
VIBEFORGE_LLM_REFINE_MAX_TOKENS=3000

# Media studios
VIBEFORGE_IMAGE_MODEL=qwen-image-3.0-pro
VIBEFORGE_VIDEO_MODEL=wan3.0-video
VIBEFORGE_IMAGE_COUNT=4
VIBEFORGE_VIDEO_DURATION=5
VIBEFORGE_VIDEO_RESOLUTION=720P
VIBEFORGE_MEDIA_TIMEOUT=900
VIBEFORGE_VIDEO_POLL_INTERVAL=10

# Access, accounts and sessions
# The first admin is created at startup; other users can self-register.
VIBEFORGE_ADMIN_USER=admin
VIBEFORGE_ADMIN_PASSWORD=change-me
# open | closed
VIBEFORGE_REGISTRATION=open
VIBEFORGE_REGISTRATION_MAX_PER_HOUR=5
VIBEFORGE_AUTH_TTL=604800
# Set to 1 when serving over HTTPS; 0 only for local HTTP development.
VIBEFORGE_COOKIE_SECURE=0
# React build sandbox (OpenSandbox server, Docker runtime)
# off | opensandbox
VIBEFORGE_SANDBOX=off
VIBEFORGE_SANDBOX_DOMAIN=127.0.0.1:8080
VIBEFORGE_SANDBOX_API_KEY=
VIBEFORGE_SANDBOX_PROTOCOL=http
VIBEFORGE_SANDBOX_SERVER_PROXY=1
VIBEFORGE_SANDBOX_IMAGE=node:24-bookworm-slim
VIBEFORGE_SANDBOX_CPU=1
VIBEFORGE_SANDBOX_MEMORY=1Gi
VIBEFORGE_SANDBOX_TTL=900
VIBEFORGE_SANDBOX_READY_TIMEOUT=120
VIBEFORGE_SANDBOX_REQUEST_TIMEOUT=600
VIBEFORGE_SANDBOX_CONCURRENCY=2
# allowlist | open
VIBEFORGE_SANDBOX_EGRESS=allowlist
VIBEFORGE_SANDBOX_EGRESS_ALLOW=*.npmmirror.com,registry.npmjs.org,*.npmjs.org
VIBEFORGE_NPM_REGISTRY=https://registry.npmmirror.com
VIBEFORGE_NPM_INSTALL_TIMEOUT=240
VIBEFORGE_NPM_BUILD_TIMEOUT=240
VIBEFORGE_NEXT_ARTIFACT_MAX_BYTES=125829120

# Next.js SSR runtime
VIBEFORGE_RUNTIME_TTL=3600
VIBEFORGE_RUNTIME_IDLE=600
VIBEFORGE_RUNTIME_READY_TIMEOUT=90
VIBEFORGE_RUNTIME_PORT=3000
# 0 = runtime is started/stopped but /apps preview is disabled (recommended until a domain exists)
VIBEFORGE_SSR_PREVIEW=0

# Copy legacy flat projects into the first admin's account at startup.
VIBEFORGE_AUTO_MIGRATE=1
# Optional database path (defaults to data/vibeforge.db).
# VIBEFORGE_DB=/data/vibeforge.db
