# Server
VIBEFORGE_HOST=0.0.0.0
VIBEFORGE_PORT=12888
VIBEFORGE_STEP_DELAY=0.55
VIBEFORGE_MAX_CONCURRENT=4

# Optional OpenAI-compatible model endpoint.
# Without a base URL the deterministic local director is used.
VIBEFORGE_LLM_ENABLED=0
VIBEFORGE_LLM_BASE_URL=
VIBEFORGE_LLM_API_KEY=
VIBEFORGE_LLM_MODEL=
VIBEFORGE_LLM_TIMEOUT=45
VIBEFORGE_LLM_MAX_TOKENS=1200
VIBEFORGE_LLM_REFINE_MAX_TOKENS=3000

# Access protection (required in production)
VIBEFORGE_PASSWORD=change-me
VIBEFORGE_SECRET=replace-with-a-long-random-string
VIBEFORGE_AUTH_TTL=604800
# Set to 1 when serving over HTTPS; 0 only for local HTTP development.
VIBEFORGE_COOKIE_SECURE=0
